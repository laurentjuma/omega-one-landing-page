  "about": {
    "title": "About Us",
    "hero": {
      "eyebrow": "Kisumu · Since 1983",
      "title": "The first and",
      "titleAccent": "the last of its kind",
      "subtitle": "Charles Ogweno flew jets for the Kenya Air Force before he ever touched a turntable. He named the sound Omega One because it was meant to be the only one that lasted. Four decades on, it is the one still standing.",
      "image": null
    },
    "story": {
      "title": "Our story",
      "note": "Four decades",
      "lede": "Omega One has been a household name in western Kenya since 1983 — a mobile disco that grew into a sound company, a concert stage and a recording studio. The rivals it started against, Intercity, Funkatek and Galaxy, are all gone.",
      "milestones": [
        {
          "year": "1982",
          "title": "Out of the cockpit",
          "text": "Ogweno joins the Kenya Air Force as a flight cadet and trains as a pilot in the UK. After the attempted coup he is detained, and on release he leaves the force for good."
        },
        {
          "year": "1983",
          "title": "Omega One begins",
          "text": "He names the mobile disco Omega One — the first and the last of its kind. Intercity, Funkatek and Galaxy all came after, and none of them lasted."
        },
        {
          "year": "1990s",
          "title": "The residencies",
          "text": "Years on rotation at Tokyo Omega Lodge in Otonglo and Webbs Club in Kisii, with shows out to Mombasa, Kitale, Kapsabet and Nakuru."
        },
        {
          "year": "2000s",
          "title": "Sound Check Studio",
          "text": "The ground floor of the family house in Kisumu becomes a recording studio. Ohangla maestro Tony Nyadundo and Onyi Papa Jay both cut tracks there."
        },
        {
          "year": "Today",
          "title": "Still on the road",
          "text": "Full live sound reinforcement for concerts, rallies and the international bands that tour the western region — with the DJs Omega trained now working across Kenya."
        }
      ]
    },
